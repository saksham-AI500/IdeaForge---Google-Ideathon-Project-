# === Backend Environment Variables ===
# Copy this file to .env and fill in real values. NEVER commit .env.

# Port the Express server listens on (Cloud Run sets this automatically)
PORT=8080

# Path to Firebase service-account JSON for local dev.
# On Cloud Run this is not needed — default credentials are used.
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=

# Gemini API key — stored in Secret Manager in production.
# For local dev, paste the key here. NEVER commit the real key.
GEMINI_API_KEY=

# Primary and fallback Gemini model names (for the fallback ladder)
GEMINI_PRIMARY_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash-lite

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Tavily Search API key — used server-side only for real-world evidence checking
TAVILY_API_KEY=

